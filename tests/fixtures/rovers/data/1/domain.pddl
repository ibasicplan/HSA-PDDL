(define (domain rover)
  (:requirements :strips :typing)
  (:types rover waypoint lander store)
  (:predicates
    (at ?r - rover ?w - waypoint)
    (at_lander ?l - lander ?w - waypoint)
    (available ?r - rover)
    (visible ?from - waypoint ?to - waypoint)
    (can_traverse ?r - rover ?from - waypoint ?to - waypoint)
    (store_of ?s - store ?r - rover)
    (empty ?s - store)
    (have_soil_analysis ?r - rover ?w - waypoint)
    (communicated_soil_data ?w - waypoint)
  )
  (:action navigate
    :parameters (?r - rover ?from - waypoint ?to - waypoint)
    :precondition (and (at ?r ?from) (available ?r) (can_traverse ?r ?from ?to) (visible ?from ?to))
    :effect (and (not (at ?r ?from)) (at ?r ?to))
  )
)
